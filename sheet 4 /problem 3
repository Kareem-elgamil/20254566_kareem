 public static double computeArea(double radius) {
        return Math.PI * radius * radius;
    }

  
     public static double computeArea(double length, double width) {
        return length * width;
    }

    
    public static  double computeArea(double base, double height, boolean isTriangle) {
        return ( base * height ) /2.0;
    }

    public static void main(String[] args) {
       
        System.out.println("Area of Circle: " + computeArea(5.0));
        System.out.println("Area of Rectangle: " + computeArea(4.0, 6.0));
        System.out.println("Area of Triangle: " + computeArea(4.0, 6.0, true));
    }
