class Employee {

    private String name;
    private int id;
    private double salary;


    public Employee(String name, int id, double salary) {
        this.name = name;
        this.id = id;
        this.salary = salary;
    }


    public String getName() {
        return name;
    }

    public void setName(String name) {
        this.name = name;
    }

    public int getId() {
        return id;
    }

    public void setId(int id) {
        this.id = id;
    }

    public double getSalary() {
        return salary;
    }

    public void setSalary(double salary) {
        this.salary = salary;
    }

    public double calculateBonus() {
        return salary * 0.10;
    }

  
    public double calculateBonus(double percentage) {
        return salary * (percentage / 100);
    }

    public void displayInfo() {
        System.out.println("Name: " + name);
        System.out.println("ID: " + id);
        System.out.println("Salary: " + salary);
    }


    @Override
    public String toString() {
        return "Name: " + name +
               ", ID: " + id +
               ", Salary: " + salary;
    }
}


class Manager extends Employee {

    private String department;
    private double allowance;

   
    public Manager(String name, int id, double salary,
                   String department, double allowance) {

        super(name, id, salary);

        this.department = department;
        this.allowance = allowance;
    }


    public String getDepartment() {
        return department;
    }

    public void setDepartment(String department) {
        this.department = department;
    }

    public double getAllowance() {
        return allowance;
    }

    public void setAllowance(double allowance) {
        this.allowance = allowance;
    }


    @Override
    public double calculateBonus() {
        return getSalary() * 0.20;
    }


    @Override
    public void displayInfo() {
        super.displayInfo();

        System.out.println("Department: " + department);
        System.out.println("Allowance: " + allowance);
    }


    @Override
    public String toString() {
        return super.toString() +
               ", Department: " + department +
               ", Allowance: " + allowance;
    }
}


public class Main {
    public static void main(String[] args) {

        
        Employee emp = new Employee("Ahmed", 101, 10000);

       
        Manager mgr = new Manager(
            "Mona", 102, 20000, "IT", 3000
        );


        Employee ref = new Manager(
            "Ali", 103, 15000, "HR", 2500
        );



        System.out.println("Employee Bonus: "
                           + emp.calculateBonus());

        System.out.println("Employee Bonus (15%): "
                           + emp.calculateBonus(15));

        System.out.println("Manager Bonus: "
                           + mgr.calculateBonus());

        System.out.println("Manager Bonus (15%): "
                           + mgr.calculateBonus(15));



        System.out.println(" Employee Information ");
        emp.displayInfo();

        System.out.println(" Manager Information ");
        mgr.displayInfo();

       
        System.out.println(" Employee toString ");
        System.out.println(emp);

        System.out.println(" Manager toString ");
        System.out.println(mgr);

       
        System.out.println(" Parent Reference ");

        ref.displayInfo();

        System.out.println("Bonus: " + ref.calculateBonus());

        System.out.println(ref);
    }
}
